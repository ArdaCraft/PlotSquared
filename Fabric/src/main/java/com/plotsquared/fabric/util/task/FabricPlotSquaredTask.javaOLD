package com.plotsquared.fabric.util.task;

import com.fastasyncworldedit.core.util.task.Task;
import com.plotsquared.core.util.task.PlotSquaredTask;
import com.plotsquared.core.util.task.TaskManager;
import com.plotsquared.fabric.FabricPlatform;
import com.sk89q.worldedit.event.Cancellable;
import org.checkerframework.checker.nullness.qual.NonNull;
import org.jetbrains.annotations.NotNull;

import java.util.concurrent.CompletableFuture;
import java.util.concurrent.ExecutionException;
import java.util.concurrent.Executors;
import java.util.concurrent.TimeUnit;


public class FabricPlotSquaredTask implements PlotSquaredTask, Comparable<FabricPlotSquaredTask> {

    @NonNull
    private final Runnable runnable;
    public final int taskId = FabricTaskManager.getTasksQueue().size();
    public long time;
    public long interval;
    public boolean repeat;
    public boolean async;
    public boolean cancelled;

    public FabricPlotSquaredTask(
            final @NonNull Runnable runnable
    ) {
        this.runnable = runnable;
    }

    @Override
    public void run() {
        if (async) {
            CompletableFuture.runAsync(this.runnable);
        } else {
            this.runnable.run();
        }
    }

    @Override
    public boolean isCancelled() {
        return this.cancelled;
    }

    @Override
    public void cancel() {
        this.cancelled = true;
    }

    @Override
    public void runTask() {
        this.time = FabricPlatform.SERVER.getTickCount();
        this.interval = 0;
        this.repeat = false;
        this.async = false;
        FabricTaskManager.addTask(this);
    }

    public void runTaskTimer(long interval) {
        this.time = FabricPlatform.SERVER.getTickCount();
        this.interval = interval;
        this.async = false;
        this.repeat = true;
        FabricTaskManager.addTask(this);
    }

    public void runTaskTimerAsynchronously(long interval) {
        this.time = FabricPlatform.SERVER.getTickCount();
        this.interval = interval;
        this.async = true;
        this.repeat = true;
        FabricTaskManager.addTask(this);
    }

    public void runTaskAsynchronously() {
        this.time = FabricPlatform.SERVER.getTickCount();
        this.interval = 0;
        this.async = true;
        this.repeat = false;
        FabricTaskManager.addTask(this);
    }

    public void runTaskLater(long delay) {

        fabricTask = new FabricTask(
                FabricTaskManager.getTasksQueue().size(),
                FabricPlatform.SERVER.getTickCount() + delay,
                0,
                false,
                false
        );
        FabricTaskManager.addTask(this);
    }

    public void runTaskLaterAsynchronously(long delay) {
                FabricPlatform.SERVER.getTickCount() + delay,
                0,
                true,
                false
        );
        FabricTaskManager.addTask(this);
    }

    @Override
    public int compareTo(@NotNull final FabricPlotSquaredTask o) {
        return Integer.compare(o.taskId, this.taskId);
    }

}
